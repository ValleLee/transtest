# Copy to .env and fill in the endpoint credentials. Keep mode 600.
# This file is only for the model-driven Converter and QA roles.
DEFAULT_BACKEND=openai_compatible
DEFAULT_BASE_URL=
DEFAULT_MODEL=
DEFAULT_API_KEY=
DEFAULT_REQUEST_TIMEOUT_SECONDS=600
DEFAULT_MAX_TOKENS=8192

# Optional role-specific overrides. Each inherits DEFAULT_*.
